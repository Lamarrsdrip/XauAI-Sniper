# EAS resolves this file from the repository root but applies paths from the
# Expo project's mobile/ directory. Cloud builders install dependencies from
# package-lock.json, so local artifacts must never be uploaded.
node_modules
.git/
.expo
dist
web-build
*.log
.DS_Store
*.tsbuildinfo


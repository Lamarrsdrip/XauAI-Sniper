{
  "expo": {
    "name": "XauCloud",
    "slug": "xaucloud-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "xaucloud",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.xaucloud.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "XauCloud uses Face ID to let you sign in quickly and securely.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.xaucloud.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#BF8F26"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D10",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D10"
          }
        }
      ],
      "expo-sharing"
    ],
    "owner": "emriz.eth",
    "extra": {
      "eas": {
        "projectId": "56b4a0c0-6f10-40a6-8c03-5f06b13bf20a"
      }
    }
  }
}

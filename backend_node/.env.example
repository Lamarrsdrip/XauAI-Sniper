# XauCloud Node backend environment reference. Copy to .env and keep all
# real values in the hosting platform's secret/environment configuration.

ENVIRONMENT=production
MONGO_URL=
DB_NAME=xaucloud
JWT_SECRET=
PUBLIC_SITE_URL=https://xaucloud.io

# Existing email delivery credentials. Reuse the production values; do not
# create a second mailbox or provider for GPT Actions.
SMTP_EMAIL=
SMTP_PASSWORD=

# Dedicated, independently revocable credential used only by the private
# XauCloud Custom GPT Action. Generate with: openssl rand -base64 48
XAUCLOUD_GPT_ACTION_SECRET=
XAUCLOUD_GPT_ACTION_CONFIRMATION_TTL_SECONDS=600

# Official X account OAuth 2.0 confidential-client credentials. Store only in
# the production secret manager; never expose either value to the browser.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=https://xaucloud.io/api/admin/x-posting/oauth/callback

bool StructureRunnerActive()
{
   return InpStructureRunnerMode;
}

double EffTPMultiplier()
{
   return StructureRunnerActive() ? MathMax(InpTPMultiplier, InpStructureTPMultiplier) : InpTPMultiplier;
}


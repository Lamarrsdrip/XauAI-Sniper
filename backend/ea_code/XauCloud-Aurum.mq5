// v5.8.16 — adaptive XAU confirmation state. Callers use this to turn
// H1 disagreement into reduced size instead of a hard gold veto.
double   g_adaptiveConfirmLotMulti = 1.0;
string   g_adaptiveConfirmReason   = "";
datetime g_lastAdaptiveConfirmLog  = 0;
datetime g_lastVolKillSoftPassLog  = 0; // v5.8.25: throttle adaptive volkill pass logs

// v5.1.2 Profit Guardian state ---------------------------------------------
double   pg_dayHWM            = 0.0;   // highest equity reached today
datetime pg_pauseUntil        = 0;     // halt new entries until this time (cooldown)
bool     pg_dayHaltActive     = false; // HWM-giveback hit → no new entries today
datetime pg_dayHaltDay        = 0;     // day this halt was triggered
int      pg_lastReportedTier  = -1;    // throttle tier transition logs
int      pg_consecutiveLosses = 0;     // v5.1.2: resets on any winner; drives adaptive cooldown
datetime pg_lastLossCycleAt   = 0;     // layered closes from one basket count as one losing cycle

// v6.4.12 — Equity Growth Guard state. This layer protects account growth after
// live evidence showed one XAU loss could erase many wins when risk was mispriced.
datetime g_growthPauseUntil = 0;
string   g_growthPauseReason = "";
double   g_growthDailyPeakProfit = 0.0;
int      g_growthLossStreak = 0;
double   g_growthLastWinProfit = 0.0;
datetime g_growthLastWinAt = 0;
int      g_growthLastWinDir = 0;
datetime g_growthLastLossAt = 0;
double   g_growthLastLoss = 0.0;
double   g_evExitLearningBias = 0.0; // positive = exits were early, negative = protects earlier

// v6.19.0 ADAPTIVE EXIT MEMORY, PHASE A — segments g_evExitLearningBias by (setup,
// direction) instead of one undifferentiated global number. Bounded array (evicts
// oldest key past the cap), same step/cap constants as the global (InpEVLearningBiasStep/
// InpEVLearningBiasMax) so this is strictly a finer-grained view of the SAME learning
// signal, not a new/independent one.
struct XAU_ExitBiasEntry
{
   string   setup;
   int      dir;
   double   bias;
   int      samples;
   datetime lastUpdate;
};
#define XAU_EXIT_BIAS_MAX_KEYS 40
XAU_ExitBiasEntry g_exitBiasKeys[];

int XAU_FindExitBiasKey(string setup, int dir)
{
   for(int i = 0; i < ArraySize(g_exitBiasKeys); i++)
      if(g_exitBiasKeys[i].dir == dir && g_exitBiasKeys[i].setup == setup) return i;
   return -1;
}

// Part 4 guardrail: a key's own bias is trusted only once it has
// InpExitBiasMinSamples of its own same-key evidence; otherwise this returns the
// existing broad global bias unchanged (cold start = today's live behavior exactly,
// never a worse or undefined one). Decays linearly to 0 over InpExitBiasDecayDays
// without a fresh same-key review (Part 4: memory must decay over time).
double XAU_GetExitLearningBias(string setup, int dir)
{
   int idx = XAU_FindExitBiasKey(setup, dir);
   if(idx < 0 || g_exitBiasKeys[idx].samples < InpExitBiasMinSamples)
      return g_evExitLearningBias;
   // v6.19.0 audit fix: clamp ageDays >= 0 before computing decay. Without this, a
   // backward clock jump (VPS NTP resync, broker server clock adjustment, snapshot
   // restore -- all real possibilities on an unattended live-money VPS) between a
   // write and a subsequent read would make ageDays negative, pushing decay above
   // 1.0 and letting the resolved bias momentarily exceed InpEVLearningBiasMax --
   // the exact hard cap this mechanism is supposed to never break.
   double ageDays = MathMax(0.0, (double)(TimeCurrent() - g_exitBiasKeys[idx].lastUpdate) / 86400.0);
   double decay = MathMax(0.0, 1.0 - ageDays / MathMax(1.0, InpExitBiasDecayDays));
   return g_exitBiasKeys[idx].bias * decay;
}

void XAU_UpdateExitLearningBias(string setup, int dir, string verdict)
{
   if(dir == 0 || StringLen(setup) == 0) return;
   int idx = XAU_FindExitBiasKey(setup, dir);
   if(idx < 0)
   {
      int n = ArraySize(g_exitBiasKeys);
      if(n >= XAU_EXIT_BIAS_MAX_KEYS)
      {
         int oldest = 0;
         for(int i = 1; i < n; i++)
            if(g_exitBiasKeys[i].lastUpdate < g_exitBiasKeys[oldest].lastUpdate) oldest = i;
         idx = oldest;
      }
      else
      {
         ArrayResize(g_exitBiasKeys, n + 1);
         idx = n;
      }
      g_exitBiasKeys[idx].setup = setup;
      g_exitBiasKeys[idx].dir = dir;
      g_exitBiasKeys[idx].bias = 0.0;
      g_exitBiasKeys[idx].samples = 0;
   }
   if(verdict == "EXIT_EARLY_LEFT_PROFIT")
      g_exitBiasKeys[idx].bias = MathMin(InpEVLearningBiasMax, g_exitBiasKeys[idx].bias + InpEVLearningBiasStep);
   else if(verdict == "EXIT_GOOD_AVOIDED_REVERSAL")
      g_exitBiasKeys[idx].bias = MathMax(-InpEVLearningBiasMax, g_exitBiasKeys[idx].bias - InpEVLearningBiasStep);
   else
      g_exitBiasKeys[idx].bias *= 0.98;
   g_exitBiasKeys[idx].samples++;
   g_exitBiasKeys[idx].lastUpdate = TimeCurrent();
}
int      g_evExitReviewCount = 0;


# XauCloud backend -- environment variable reference.
# Copy to .env and fill in real values. Never commit a real .env (already
# gitignored). This file documents every variable server.py/payment_crypto.py/
# nomba_service.py read from the environment -- generated by grepping the
# actual os.environ.get()/os.environ[...] call sites, not written from memory.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=xaucloud

# --- Core auth/session ---
JWT_SECRET=                      # required in production; refuses to start without it (see server.py _load_or_create_jwt_secret)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ENVIRONMENT=production           # "development"/"dev"/"local"/"test"/"testing" enable permissive local-dev fallbacks; anything else (including unset) is treated as production
COOKIE_SECURE=true
CORS_ORIGINS=

# --- Public site ---
PUBLIC_SITE_URL=https://xauaisniper.com   # used to build every payment callback_url -- never trust a client-supplied origin instead

# --- Nomba payment migration (new) ---
# AES-256-GCM master key for backend/payment_crypto.py, used to encrypt
# Nomba client_id/client_secret/account_id/webhook_signature_key at rest
# (payment_nomba_config collection). Required before any Nomba credentials
# can be saved via the admin dashboard -- GET/PUT /admin/settings/nomba
# will report "not configured" without it, and PUT will 503.
# Generate one with:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Must decode (after base64) to exactly 32 bytes. Never stored in the
# database, never editable from the admin dashboard, never logged.
PAYMENT_CONFIG_ENCRYPTION_KEY=

# The actual Nomba client_id/client_secret/account_id/webhook_signature_key
# are entered through the Admin Dashboard (Settings -> Payments -> Nomba),
# encrypted at rest with the key above -- NOT environment variables. There
# is deliberately no NOMBA_CLIENT_ID/NOMBA_CLIENT_SECRET/etc. env var
# fallback, so credentials are never duplicated between the server
# environment and the encrypted database, and rotating them never requires
# a redeploy.

# --- Legacy Paystack (historical transactions only -- no longer used for
#     new purchases; see audits/nomba_migration/01_paystack_audit.md) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PIN_PRICE_KOBO=30000000

# --- Email (Gmail SMTP) ---
SMTP_EMAIL=
SMTP_PASSWORD=

# --- AI / cost controls (unrelated to payments) ---
EMERGENT_LLM_KEY=
AI_COST_DAILY_CALL_LIMIT=
AI_COST_MIN_SECONDS=
AI_COST_CACHE_TTL_SECONDS=
AI_COST_DUAL_AI_CONFIDENCE_GAP=

# --- Cloud/EA monitor (unrelated to payments) ---
CLOUD_AGENT_TOKEN=
WRITE_TEST_CREDENTIALS=
